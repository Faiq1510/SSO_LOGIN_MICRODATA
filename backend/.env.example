# ============================================================
# .env.example — Template environment variables untuk SSO Project
# Salin file ini menjadi .env lalu isi nilai yang diperlukan:
#   cp .env.example .env
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_NAME=sso_idp
DB_USER=sso_user
DB_PASSWORD=changeme

# ── Session & Cookie ─────────────────────────────────────────
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COOKIES_KEY=changeme
ADMIN_SESSION_SECRET=changeme

# ── OIDC / JWT (RSA Key dalam format JWKS JSON) ──────────────
# Generate dengan menjalankan: node scripts/generate-jwks.js
# atau gunakan: https://mkjwk.org (pilih RSA, 2048 bit, sig, RS256)
OIDC_JWKS={"keys":[]}

# ── CORS & Issuer ────────────────────────────────────────────
FRONTEND_ORIGIN=*
ISSUER=http://localhost:3000
