APP_NAME=SuratPenomoran
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# Docker Port Mappings on Host
# ==============================================================================
APP_PORT=8000
DB_PORT=5432
WA_PORT=3000
DB_GUI_PORT=8081
REDIS_PORT=6379

# ==============================================================================
# Database Configuration (Docker PostgreSQL)
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=surat_penomoran
DB_USERNAME=postgres
DB_PASSWORD=secret

# ==============================================================================
# Redis Configuration (Docker Redis)
# ==============================================================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# WhatsApp Baileys Server Configuration
# ==============================================================================
WA_SERVER_URL=http://wa-server:3000

# ==============================================================================
# Mail Configuration
# ==============================================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@surat-penomoran.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
