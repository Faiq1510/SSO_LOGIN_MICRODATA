# Konfigurasi Portal Launcher
PORT=9000

# URL Identity Provider SSO (Backend port 3000)
# Development lokal: http://localhost:3000
# Saat menggunakan Ngrok: https://xxxx.ngrok-free.app
IDP_ISSUER=http://localhost:3000

# OIDC Client Credentials (sesuai data di tabel clients pada DB SSO)
CLIENT_ID=portal-launcher
CLIENT_SECRET=your_client_secret_here

# URL callback setelah login berhasil (harus cocok persis dengan DB SSO)
REDIRECT_URI=http://localhost:9000/callback
POST_LOGOUT_REDIRECT_URI=http://localhost:9000/

# Koneksi langsung ke DB SSO untuk membaca daftar aplikasi
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sso_idp
DB_USER=sso_user
DB_PASSWORD=your_db_password_here
