DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=microintern
APP_PORT=5001

# CORS Configuration (optional, comma-separated list of additional allowed origins)
# CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRATION_TIME=1d

# MinIO Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_minio_root_user_here
MINIO_SECRET_KEY=your_minio_root_password_here
MINIO_BUCKET=microintern
MINIO_PUBLIC_URL=http://localhost:9002

# Mail Configuration
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

# SSO Configuration
SSO_SHARED_SECRET=your_sso_shared_secret_here
SSO_ISSUER=portal-login-microdata